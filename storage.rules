rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /negocios/{negocioId}/productos/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.size > 50 * 1024
        && request.resource.contentType.matches('image/(jpeg|png)');
    }

    match /negocios/{negocioId}/logos/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 500 * 1024
        && request.resource.contentType.matches('image/(jpeg|png)');
    }
  }
}
